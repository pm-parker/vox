		src/controlserver.h \
		src/engine.h \
		src/inserter.h \
		src/recorder.h \
		src/statusreporter.h \
		src/store.h \
		src/theme.h \
		src/translator.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o src/main.cpp


pkgname=vox
pkgver=1.1.0
pkgrel=1
pkgdesc='Voice input for Omarchy — offline dictation into any window'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'libpulse' 'wtype' 'wl-clipboard' 'curl')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/vox "$pkgdir/usr/bin/vox"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/vox.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/vox.svg"
  install -Dm644 "$startdir/vox.desktop" "$pkgdir/usr/share/applications/vox.desktop"
  # Official Omarchy dictation adapter: `omarchy default dictation vox` wires
  # Alt+Space toggle and hold-Alt_R push-to-talk to this binary.
  install -Dm755 "$startdir/omarchy-dictation-vox" "$pkgdir/usr/bin/omarchy-dictation-vox"
}

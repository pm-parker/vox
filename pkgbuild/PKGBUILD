pkgname=duckvox
pkgver=2.0.0
pkgrel=1
pkgdesc='Voice input for Omarchy — offline dictation into any window'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'libpulse' 'wtype' 'wl-clipboard' 'curl')
makedepends=('gcc' 'make')
# The recognition binary ships with the package: the SenseVoice model tarball
# on Hugging Face does not contain one, and a 35 MB static build here saves
# every user a second download (and a toolchain) at first run.
_sherpa_ver=2.0.1
_sherpa_x64="https://github.com/k2-fsa/sherpa-onnx/releases/download/v$_sherpa_ver/sherpa-onnx-v$_sherpa_ver-linux-x64-static.tar.bz2"
_sherpa_arm64="https://github.com/k2-fsa/sherpa-onnx/releases/download/v$_sherpa_ver/sherpa-onnx-v$_sherpa_ver-linux-aarch64-static.tar.bz2"
source_x86_64=("$_sherpa_x64")
source_aarch64=("$_sherpa_arm64")
sha256sums_x86_64=('8b34cf773b65e4be3e7ace12fb6a65fcd8f4e8fe06516ae9b7bcaf405dcb308c')
sha256sums_aarch64=('SKIP')

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/duckvox "$pkgdir/usr/bin/duckvox"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/duckvox.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/duckvox.svg"
  install -Dm644 "$startdir/duckvox.desktop" "$pkgdir/usr/share/applications/duckvox.desktop"
  # Official Omarchy dictation adapter: `omarchy dictation use duckvox` wires
  # Alt+Space toggle and hold-Alt_R push-to-talk to this binary.
  install -Dm755 "$startdir/omarchy-dictation-duckvox" "$pkgdir/usr/bin/omarchy-dictation-duckvox"
  # Reloads the user-tunable hotkeys written by the duckvox Shortcuts card
  # (~/.config/duckvox/shortcuts.lua, loaded by dictation-backend.lua).
  install -Dm755 "$startdir/omarchy-dictation-duckvox-keys" "$pkgdir/usr/bin/omarchy-dictation-duckvox-keys"
  # Setup-menu install/remove hooks: omarchy default dictation duckvox requires
  # omarchy-install-dictation-duckvox to exist, and remove-dictation pairs with it.
  install -Dm755 "$startdir/omarchy-install-dictation-duckvox" "$pkgdir/usr/bin/omarchy-install-dictation-duckvox"
  install -Dm755 "$startdir/omarchy-remove-dictation-duckvox" "$pkgdir/usr/bin/omarchy-remove-dictation-duckvox"
  # Omarchy bar panel: shipped canonical, synced into the user's plugins dir
  # by omarchy-install-dictation-duckvox (the shell only loads user-dir plugins).
  install -d "$pkgdir/usr/share/duckvox/panel"
  install -Dm644 "$startdir/duckvox-panel/Panel.qml" "$pkgdir/usr/share/duckvox/panel/Panel.qml"
  install -Dm644 "$startdir/duckvox-panel/Service.qml" "$pkgdir/usr/share/duckvox/panel/Service.qml"
  install -Dm644 "$startdir/duckvox-panel/manifest.json" "$pkgdir/usr/share/duckvox/panel/manifest.json"
  # sherpa-onnx-offline, pulled out of the upstream static release.
  local bin
  bin=$(find "$srcdir" -type f -name sherpa-onnx-offline -perm -u+x | head -1)
  install -Dm755 "$bin" "$pkgdir/usr/bin/sherpa-onnx-offline"
}

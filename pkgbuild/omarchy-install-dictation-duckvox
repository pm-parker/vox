#!/bin/bash

# omarchy:summary=Set up duckvox offline dictation
# omarchy:args=[--background]

set -e

background=false
if [[ ${1:-} == "--background" ]]; then
  background=true
elif (($# > 0)); then
  echo "Usage: omarchy install dictation duckvox [--background]" >&2
  exit 1
fi

# The package already ships the app, the recognition engine and the dictation
# adapter, so switching is pure backend selection. The SenseVoice model
# (~163 MB) downloads automatically on first use.
omarchy-dictation-use duckvox
# Keep the bar panel current with the packaged copy (idempotent); the shell
# only loads user-dir plugins.
if [[ -d /usr/share/duckvox/panel ]]; then
  mkdir -p ~/.config/omarchy/plugins/duckvox-panel
  cp -f /usr/share/duckvox/panel/{Panel.qml,Service.qml,manifest.json} ~/.config/omarchy/plugins/duckvox-panel/
  omarchy-shell -q shell rescanPlugins
fi
omarchy-restart-hyprctl

if [[ $background == "false" ]]; then
  omarchy-notification-send -g "" "duckvox dictation ready" "Hold Alt_R to talk, release to insert." -t 10000
fi

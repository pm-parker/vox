#!/bin/bash

# omarchy:summary=Remove vox dictation and its desktop integration
# omarchy:requires-sudo=true

set -e

# Unhook from Omarchy: stop the daemon, disable the bar panel, uninstall the
# package (models under ~/.local/share/vox are kept for a future reinstall).
pkill -x vox 2>/dev/null || true
omarchy-shell -q shell setPluginEnabled vox.panel false >/dev/null
omarchy-pkg-drop vox

# omarchy-dictation-use would refuse to switch to a backend whose adapter is
# gone, so clear the selection directly when it pointed at vox.
config="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/defaults/dictation"
if [[ -f $config && $(< "$config") == "vox" ]]; then
  rm "$config"
fi

omarchy-shell -q shell rescanPlugins
omarchy-restart-hyprctl

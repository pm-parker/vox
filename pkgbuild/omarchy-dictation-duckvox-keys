#!/bin/bash

# omarchy:summary=Apply duckvox dictation shortcuts (toggle, push-to-talk)
# omarchy:args=[--reset]

# Reload the keybindings Omarchy owns for duckvox: ALT+Space toggles, holding
# ALT+Alt_R talks (press starts, release inserts). Editing keys, not reloading,
# lives in the duckvox window's Shortcuts card; this re-derives the whole file
# from the saved settings.

set -e

shortcuts="$HOME/.config/duckvox/shortcuts.lua"
mkdir -p "$(dirname "$shortcuts")"

if [[ ${1:-} == "--reset" ]]; then
  rm -f "$shortcuts"
  echo "duckvox shortcuts reset to defaults (Alt+Space toggle, Alt_R push-to-talk)"
  omarchy-restart-hyprctl
  exit 0
fi

toggle_key=$(duckvox --print-setting shortcuts.toggleKey 2>/dev/null || echo "ALT + SPACE")
ptt_key=$(duckvox --print-setting shortcuts.pttKey 2>/dev/null || echo "ALT + Alt_R")

# The keys are DATA inside the generated Lua, not code: they ride in as
# pcall arguments through [==[ ]==] long-bracket strings, so a quote in a
# key no longer breaks the Hyprland config. Newlines and a "]]"-like run
# would still damage the file, so they are flattened first.
sanitize_key() {
  local key=$1
  key=${key//$'\n'/ }
  key=${key//$'\r'/ }
  key=${key//]/}
  printf '%s' "$key"
}
toggle_key=$(sanitize_key "$toggle_key")
ptt_key=$(sanitize_key "$ptt_key")

# o.bind/bind_hold and hl.unbind are the documented public helpers; dofile
# shares the main config's globals, so they resolve here exactly as in
# /usr/share/omarchy/default/hypr/bindings/dictation.lua.
cat > "$shortcuts" <<EOF
-- Generated by duckvox — edit keys in the duckvox window (Shortcuts card), or
-- by hand here, then run omarchy-dictation-duckvox reload-keys to apply them.
local ok, err = pcall(function(toggle, ptt)
  hl.unbind(toggle)
  hl.unbind(ptt)
  o.bind(toggle, "Toggle duckvox dictation", "omarchy-dictation toggle")
  o.bind_hold(ptt, "Talk to duckvox (push-to-talk)", "omarchy-dictation start",
              "Insert (push-to-talk)", "omarchy-dictation stop", { ignore_mods = true })
end, [==[$toggle_key]==], [==[$ptt_key]==])
if not ok then
  print("duckvox shortcuts failed: " .. tostring(err))
end
EOF

omarchy-restart-hyprctl
echo "duckvox shortcuts applied: $toggle_key toggles, $ptt_key push-to-talk"
